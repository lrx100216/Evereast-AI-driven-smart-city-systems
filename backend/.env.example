# DeepSeek API key (get one at https://platform.deepseek.com/)
DEEPSEEK_API_KEY=sk-your-key-here

# Serial port for Arduino
#   Windows: COM3
#   macOS:   /dev/tty.usbmodem*  or /dev/ttyACM0
#   Linux:   /dev/ttyUSB0  or /dev/ttyACM0
# Leave empty to run in simulation mode (default)
SERIAL_PORT=

# CORS origins (comma-separated). Defaults to localhost dev servers.
# CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# CPU count for parallel training (default: auto-detect all cores minus 1)
# Set to override, e.g. SMART_CITY_CPU_COUNT=4
# SMART_CITY_CPU_COUNT=
